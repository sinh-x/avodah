# Avodah web app — HTTP-only, terminated upstream by drgnfly-caddy.
# TLS is handled by the external (drgnfly) Caddy; this server sits behind it
# on localhost:8080 and speaks plain HTTP.
http://:{$WEB_PORT:-8080} {
    # Serve Flutter web static assets from /srv
    root * /srv
    file_server

    # Set COOP/COEP headers for OPFS (Required for Drift WasmDatabase)
    header Cross-Origin-Opener-Policy same-origin
    header Cross-Origin-Embedder-Policy require-corp

    # WASM and JS MIME types (required for Drift WasmDatabase)
    @wasm {
        path *.wasm
    }
    header @wasm Content-Type application/wasm
    @js {
        path *.js
    }
    header @js Content-Type application/javascript

    # Security headers
    header X-Content-Type-Options nosniff
    header X-Frame-Options DENY
    header X-XSS-Protection "1; mode=block"

    # Health check endpoint
    @health {
        path /health
    }
    respond @health 200

    # /avodah/api/sync/* → sync server (HTTP loopback; drgnfly-caddy terminates TLS)
    @sync {
        path /avodah/api/sync/*
    }
    handle @sync {
        uri strip_prefix /avodah
        reverse_proxy {$SYNC_SERVER_HOST:-127.0.0.1}:{$SYNC_SERVER_PORT:-9847}
    }

    # /avodah/ws → sync server WebSocket (HTTP loopback)
    @ws {
        path /avodah/ws
    }
    handle @ws {
        uri strip_prefix /avodah
        reverse_proxy {$SYNC_SERVER_HOST:-127.0.0.1}:{$SYNC_SERVER_PORT:-9847}
    }

    # All other /avodah/api/* routes → pa-serve directly (no auth required)
    @api {
        path /avodah/api/*
    }
    handle @api {
        uri strip_prefix /avodah
        reverse_proxy {$AGENT_API_HOST:-127.0.0.1}:{$AGENT_API_PORT:-9848}
    }
}
