# Avodah web app — HTTP-only, terminated upstream by drgnfly-caddy.
# TLS is handled by the external (drgnfly) Caddy at https://drgnfly/avodah,
# which strips the /avodah prefix before forwarding to localhost:8080.
# This Caddy only serves the Flutter web bundle; API and WebSocket routes
# are handled directly by drgnfly-caddy → sync_server (9847) / pa-serve (9848).
http://:{$WEB_PORT:-8080} {
    # Serve Flutter web static assets from /srv
    root * /srv
    file_server

    # Set COOP/COEP headers for OPFS (Required for Drift WasmDatabase)
    header Cross-Origin-Opener-Policy same-origin
    header Cross-Origin-Embedder-Policy require-corp

    # WASM and JS MIME types (required for Drift WasmDatabase)
    @wasm {
        path *.wasm
    }
    header @wasm Content-Type application/wasm
    @js {
        path *.js
    }
    header @js Content-Type application/javascript

    # Security headers
    header X-Content-Type-Options nosniff
    header X-Frame-Options DENY
    header X-XSS-Protection "1; mode=block"

    # Health check endpoint
    @health {
        path /health
    }
    respond @health 200
}
